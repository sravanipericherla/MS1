<?xml version="1.0" encoding="UTF-8"?>
<server description="IBM WebSphere Liberty - Legacy IBM Content Manager Migration Demo">

    <!-- Enable Jakarta EE 10 features for Enterprise Application (EAR) and Servlets -->
    <featureManager>
        <feature>jakartaee-10.0</feature>
    </featureManager>

    <!-- Basic User Registry required for full enterprise application profile -->
    <basicRegistry id="basic" realm="BasicRealm">
        <user name="admin" password="adminPassword" />
    </basicRegistry>

    <!-- Bind HTTP endpoint to Port 8080 across all container interfaces -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="8080"
                  httpsPort="9443" />

    <!-- Automatically expand and monitor applications -->
    <applicationManager autoExpand="true"/>

</server>
