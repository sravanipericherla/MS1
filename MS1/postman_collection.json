    {
      "key": "base_url_ms2",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "base_url_ms1",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "base_url_ear",
      "value": "http://localhost:8080/legacy-cm-web",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "legacy-app",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "cm-secret-123",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "demo-cm-token-12345",
      "type": "string"
    },
    {
