  "item": [
    {
      "name": "1. OAuth2 Authentication",
      "item": [
        {
          "name": "1.1 Get OAuth2 Access Token (Auto Updates Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token response contains access_token\", function () {",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "    pm.expect(jsonData.token_type).to.eql('Bearer');",
                  "});",
                  "",
                  "// AUTOMATED UPDATE: Store the new token in collection and environment variables",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
                  "    if (pm.environment) {",
                  "        pm.environment.set(\"access_token\", jsonData.access_token);",
                  "    }",
                  "    console.log(\"[Postman Auto-Auth] Automatically updated access_token:\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "documents:read documents:write",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url_ms2}}/oauth/token",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "description": "Requests OAuth2 Bearer token using Client-Credentials flow. Automatically saves the returned token into {{access_token}} variable for all subsequent requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Target REST API - MS2 (Port 8082)",
      "item": [
        {
          "name": "2.1 Upload Document (Multipart Stream)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Document uploaded successfully (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"document_id\", jsonData.id.toString());",
                  "    console.log(\"[Postman] Auto-saved new document_id:\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "itemType",
                  "value": "INSURANCE_POLICY",
                  "type": "text"
                },
                {
                  "key": "author",
                  "value": "POSTMAN_CLIENT",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url_ms2}}/api/v1/documents",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            },
            "description": "Uploads document binary payload via multipart/form-data. Protected by OAuth2 Bearer token."
          },
          "response": []
        },
        {
          "name": "2.2 Stream Document Binary Content (Chunked Transfer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Disposition header exists\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Content-Disposition\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_ms2}}/api/v1/documents/{{document_id}}/content",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{document_id}}",
                "content"
              ]
            },
            "description": "Streams binary document content chunk-by-chunk via HTTP OutputStream. Demonstrates chunked transfer over REST."
          },
          "response": []
        },
        {
          "name": "2.3 Get Document Metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_ms2}}/api/v1/documents/{{document_id}}",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{document_id}}"
              ]
            },
            "description": "Returns document metadata JSON without loading binary payload into memory."
          },
          "response": []
        },
        {
          "name": "2.4 List All Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url_ms2}}/api/v1/documents",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            },
            "description": "Lists all document records with download links and metadata."
          },
          "response": []
        },
        {
          "name": "2.5 Existing MS2 Persons List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_ms2}}/ms2/persons",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "ms2",
                "persons"
              ]
            },
            "description": "Verifies existing microservice functionality remains 100% operational."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Legacy Db2 SQL Gap Analysis (Port 8082)",
      "item": [
        {
          "name": "3.1 Trace Legacy Db2 SQL Query Join",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response contains legacyDb2Query and migrationGapAnalysis\", function () {",
                  "    pm.expect(jsonData.legacyDb2Query).to.be.a('string');",
                  "    pm.expect(jsonData.migrationGapAnalysis).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_ms2}}/api/v1/legacy/trace-sql?itemId={{item_id}}",
              "host": [
                "{{base_url_ms2}}"
              ],
              "path": [
                "api",
                "v1",
                "legacy",
                "trace-sql"
              ],
              "query": [
                {
                  "key": "itemId",
                  "value": "{{item_id}}"
                }
              ]
            },
            "description": "Executes and traces the complex SQL join across ICMSTITEMS001001, ICMSTITEMTYPEDEFS, and ICMSTCOLLNAME001001, providing field-by-field gap analysis."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Legacy J2EE EAR Application (Port 8080)",
      "item": [
        {
