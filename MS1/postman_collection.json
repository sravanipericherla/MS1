{
  "info": {
    "_postman_id": "c1f7b82e-9988-4221-a392-7489ab921cde",
    "name": "IBM Content Manager to Spring Boot REST Migration Demo",
    "description": "Comprehensive Postman collection covering legacy J2EE EAR migration to Spring Boot REST APIs.\nIncludes automated OAuth2 token handling, document multipart streaming, legacy Db2 SQL trace, and multi-service testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
